{
  "name": "YOLO26 Streamlit",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "remote.restoreForwardedPorts": false,
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.interpreters.exclude": [
          "**"
        ],
        "python.interpreters.include": [
          "/usr/local/bin/python"
        ],
        "jupyter.kernels.filter": [
          {
            "path": "/usr/local/bin/python",
            "type": "pythonEnvironment"
          }
        ]
      }
    }
  },
  // - Update base image package index
  // - Install OpenGL dispatch layer package
  // - Update pip
  // - Create gitignored directories for model weights and data files
  // - Install project Python dependencies
  "postCreateCommand": "sudo apt-get update -y && sudo apt-get install -y libgl1 && mkdir -p models data && python -m pip install --upgrade pip && pip install -r requirements.txt"
}
