{
  "name": "YOLO26 Streamlit",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {

        // Don't restore forwarded ports automatically
        "remote.restoreForwardedPorts": false,

        // Set the default Python interpreter
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        
        // Exclude other Python versions from Jupyter kernel list
        "jupyter.kernels.excludePythonEnvironments": [
          "/usr/bin/python3",
          "/usr/bin/python3.13"
        ]
      }
    }
  },
  // - Update base image package index
  // - Install OpenGL dispatch layer and glib packages required by opencv-python-headless
  // - Update pip
  // - Create gitignored directories for model weights and data files
  // - Install project Python dependencies
  "postCreateCommand": "sudo apt-get update -y && sudo apt-get install -y libgl1 libglib2.0-0t64 && mkdir -p models data && python -m pip install --upgrade pip && pip install -r requirements.txt"
}
